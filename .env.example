# Copy to .env for local dev. .env is gitignored.

# Standalone-mode endpoints read this for the default OpenAI credential.
OPENAI_API_KEY=

# Governed-mode tests read these.
SPARK_AI_GOVERNED_TESTS=
GRAVITINO_URI=http://localhost:8090
GRAVITINO_METALAKE=prod
GRAVITINO_CATALOG=ai_functions

# Dev-only override for @governed pass-through user.
SPARK_AI_USER=dev@localhost

# Service-mode config (ODP/Ambari/xDP style)
# SPARK_AI_MODE=auto                # auto|standalone|governed
# SPARK_AI_GRAVITINO_URI=http://localhost:8090
# SPARK_AI_METALAKE=prod
# SPARK_AI_CATALOG=ai_functions
# SPARK_AI_ENDPOINTS_SCHEMA=endpoints
# SPARK_AI_FUNCTIONS_SCHEMA=functions
# SPARK_AI_ENDPOINTS_JSON={"endpoints":[{"name":"internal-llm","endpoint_type":"openai_chat","base_url":"https://llm.internal/v1","model_id":"llama-3.3-70b","credential_name":"internal-llm","data_residency":"internal"}]}
# SPARK_AI_ENDPOINTS_JSON_PATH=/etc/spark-ai-functions/endpoints.json
# SPARK_AI_FUNCTION_NAMES=ai_query,ai_mask,ai_parse_document
